<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Default: TERANG (permintaan user; ZCode PC default dark → tersedia sebagai AppTheme.Dark) -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/light_bg</item>
        <item name="android:statusBarColor">@color/light_header</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/light_bg</item>
        <item name="cBg">@color/light_bg</item>
        <item name="cHeader">@color/light_header</item>
        <item name="cSidebar">@color/light_sidebar</item>
        <item name="cCard">@color/light_card</item>
        <item name="cFg">@color/light_fg</item>
        <item name="cFgSubtle">@color/light_fg_subtle</item>
        <item name="cFgSubtlest">@color/light_fg_subtlest</item>
        <item name="cBorder">@color/light_border</item>
        <item name="cBorderHover">@color/light_border_hover</item>
        <item name="cSecondary">@color/light_secondary</item>
        <item name="cSurface">@color/light_surface</item>
        <item name="cSuccess">@color/light_success</item>
        <item name="cWarning">@color/light_warning</item>
        <item name="cDestructive">@color/light_destructive</item>
        <item name="cAsk">@color/light_ask</item>
        <item name="cBrand">@color/light_brand</item>
        <item name="cBrandFg">@color/light_brand_fg</item>
        <item name="cCodeBg">@color/light_code_bg</item>
        <item name="cCodeFg">@color/light_code_fg</item>
    </style>

    <!-- Cadangan: GELAP — palet theme-zai-dark asli ZCode -->
    <style name="AppTheme.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:statusBarColor">@color/dark_header</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/dark_bg</item>
        <item name="cBg">@color/dark_bg</item>
        <item name="cHeader">@color/dark_header</item>
        <item name="cSidebar">@color/dark_sidebar</item>
        <item name="cCard">@color/dark_card</item>
        <item name="cFg">@color/dark_fg</item>
        <item name="cFgSubtle">@color/dark_fg_subtle</item>
        <item name="cFgSubtlest">@color/dark_fg_subtlest</item>
        <item name="cBorder">@color/dark_border</item>
        <item name="cBorderHover">@color/dark_border_hover</item>
        <item name="cSecondary">@color/dark_secondary</item>
        <item name="cSurface">@color/dark_surface</item>
        <item name="cSuccess">@color/dark_success</item>
        <item name="cWarning">@color/dark_warning</item>
        <item name="cDestructive">@color/dark_destructive</item>
        <item name="cAsk">@color/dark_ask</item>
        <item name="cBrand">@color/dark_brand</item>
        <item name="cBrandFg">@color/dark_brand_fg</item>
        <item name="cCodeBg">@color/dark_code_bg</item>
        <item name="cCodeFg">@color/dark_code_fg</item>
    </style>

    <!-- Chip perintah cepat halaman Terminal -->
    <style name="TermChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?attr/cFgSubtle</item>
    </style>
</resources>
