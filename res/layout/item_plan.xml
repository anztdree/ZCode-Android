<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_tool_card"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_target"
                android:tint="?attr/cAsk"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="RENCANA IMPLEMENTASI"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/cAsk"
                android:letterSpacing="0.06"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:textColor="?attr/cFg"
            android:maxLines="14"
            android:ellipsize="end"/>

        <LinearLayout
            android:id="@+id/planButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnApprove"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_send"
                android:text="Setujui &amp; Terapkan"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/cBrandFg"/>

            <TextView
                android:id="@+id/btnReject"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:background="@drawable/bg_chip"
                android:text="Tolak"
                android:textSize="13sp"
                android:textColor="?attr/cFg"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
