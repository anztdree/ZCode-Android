<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/toolCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_tool_card"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ico"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_file_text"
                android:tint="?attr/cFgSubtle"/>

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textSize="13sp"
                android:textColor="?attr/cFg"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/txtStat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:text="Berjalan…"/>

            <ImageView
                android:id="@+id/chev"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_chevron_down"
                android:tint="?attr/cFgSubtlest"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_tool_output"
            android:padding="8dp"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:lineSpacingExtra="1dp"
            android:textColor="?attr/cFgSubtle"
            android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
